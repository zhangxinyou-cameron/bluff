# Runtime tools and installed dependencies stay on this machine.
/node.exe
/cloudflared.exe
/node_modules/
/*.zip

# Local data and environment secrets are never versioned.
/data/
.env
.env.*
!.env.example
*.log
*.pid
*.tmp
.DS_Store
Thumbs.db
__pycache__/
*.pyc

# Reproducible browser outputs (test scripts and verification notes are kept).
/tests/screenshots/
/tests/*-report.json
/tests/voice-selfcheck.json
/tests/voice-tone.wav
/test-results/
/playwright-report/
.codex/
.agents/

# Original GitHub scaffold exclusions
# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.
